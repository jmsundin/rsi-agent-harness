# Meta Model API (OpenAI-compatible). https://dev.meta.ai
MODEL_API_KEY=
MODEL_API_BASE=https://api.meta.ai/v1

# Stage -> model routing. Wonder = improver/frame/sceptic. Spark = volume work.
RATCHET_MODEL_IMPROVER=muse-wonder-1.0
RATCHET_MODEL_WORKER=muse-spark-1.3

# Optional: route the inner scorer to an open-weights model on a partner
# (Baseten/Modal/Fireworks). Leave blank to use MODEL_API_BASE.
RATCHET_WORKER_API_BASE=
RATCHET_WORKER_API_KEY=

# Hard caps, in USD.
RATCHET_CAP_PER_RUN=3.00
RATCHET_CAP_PER_GENERATION=1.50
RATCHET_CAP_TOTAL=120.00

# Set to 1 to run everything with a deterministic mock model (no API calls).
RATCHET_MOCK=0
